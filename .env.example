# Next.js / Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# Socket service
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
SOCKET_INTERNAL_SECRET=replace-with-long-random-secret
ALLOWED_WEB_ORIGINS=http://localhost:3000
# In production the relay refuses to start unless SOCKET_INTERNAL_SECRET is >= 32
# chars and ALLOWED_WEB_ORIGINS is a real, non-wildcard origin list. Without the
# secret every room token is rejected, so failing at boot is deliberate.
SOCKET_PORT=4001

# Required in production; the relay refuses to boot without them.
#
# RELAY_SINGLE_INSTANCE: the relay keeps the teacher writer lease, hot board
# state, revocation tombstones, and rate counters in process memory. Socket.IO
# needs sticky sessions plus an adapter to span instances and this relay has
# neither, so it is only correct at one replica. Setting this to "1" is an
# explicit acknowledgement that replicas are pinned to 1.
RELAY_SINGLE_INSTANCE=1
#
# RELAY_TRUST_PROXY: "1" when the relay sits behind exactly one trusted proxy or
# load balancer, so the client address for per-address connection limits is read
# from the last X-Forwarded-For hop; "0" when clients reach this process
# directly. There is no safe default: "0" behind a balancer collapses every
# client onto one address and caps the whole service, while "1" without a proxy
# lets a forged header bypass the cap.
RELAY_TRUST_PROXY=0
# Per-event relay logging. board:update and teacher:viewport fire at stroke and
# scroll frame rate, so this is off unless explicitly set to 1.
SOCKET_DEBUG_EVENTS=

# Public app URL used for QR join links
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set this to the canonical HTTPS origin in production. It drives metadata,
# JSON-LD, robots.txt, sitemap.xml, and the optional llms.txt response.

# Local/dev teacher bootstrap. Both this flag and development mode are required;
# never set either value in a production deployment.
ALLOW_DEV_TEACHER=1
NEXT_PUBLIC_ENABLE_LOCAL_TEACHER=1
ALLOW_PROOF_SOCKET=1

# Private Convex -> Socket.IO room-revocation callback (production only)
SOCKET_SERVICE_INTERNAL_URL=

# AI provider adapter (choose one implementation at a time).
# Post-class summary notes read AI_PROVIDER: "mock" (offline, deterministic),
# "gemini" (needs GOOGLE_GENERATIVE_AI_API_KEY), anything else = disabled.
# These are read by Convex ACTIONS, so they must also be set on the Convex
# deployment:  npx convex env set AI_PROVIDER gemini
AI_PROVIDER=mock
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override; defaults to gemini-2.5-flash.
GEMINI_MODEL=
# Not wired yet — providers/openai.ts does not exist.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODERATION_API_URL=
MODERATION_API_KEY=

# AI board drafting (phase 12). Both values are required before drafting turns
# on; with either missing the teacher sees "AI drafting is not configured" and
# the manual authoring path is unaffected. Set these on the Convex deployment.
BOARD_AUTHORING_API_URL=
BOARD_AUTHORING_API_KEY=

# Google OAuth for Convex Auth (set on the Convex deployment, not only .env.local):
#   npx convex env set AUTH_GOOGLE_ID ...
#   npx convex env set AUTH_GOOGLE_SECRET ...
#   npx convex env set SITE_URL http://localhost:3000
# Google Console redirect URI must be:
#   https://<deployment>.convex.site/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SITE_URL=http://localhost:3000

# Optional observability
SENTRY_DSN=

# ── Launch-time safety switches ─────────────────────────────────────────────
# Fail the build/start when the production environment is incomplete. Vercel
# sets VERCEL_ENV=production automatically; set this on any other host.
SYNCVAS_ENFORCE_ENV=
# Content-Security-Policy is sent Report-Only until this is 1. Watch the browser
# console for violations on a full classroom run, then switch it on.
CSP_ENFORCE=
